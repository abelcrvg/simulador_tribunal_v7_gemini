# Server
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Session/auth
# Local development: set to true to use /api/auth/local/login without Manus OAuth.
LOCAL_AUTH=true
JWT_SECRET=change-me-to-a-long-random-secret
COOKIE_SECRET=change-me-to-a-long-random-secret

# AI Router
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
BUILT_IN_FORGE_API_KEY=
MANUS_MODEL=gemini-2.5-flash

# Manus OAuth (only if using Manus login; leave empty for local development)
VITE_LOCAL_AUTH=true
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
