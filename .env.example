# Server
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Session/auth
# Local development: set to true to use /api/auth/local/login without Manus OAuth.
LOCAL_AUTH=true
JWT_SECRET=change-me-to-a-long-random-secret
COOKIE_SECRET=change-me-to-a-long-random-secret

# AI Router
# Ordem: OpenCode -> OpenRouter (todos os modelos :free) -> Gemini/OpenAI/Ollama/Manus
AI_PROVIDER=opencode

# OpenCode (principal) — reutiliza o background service; sem chave necessária.
# Por padrão lê ~/.local/state/opencode/service.json (url + senha local).
OPENCODE_ENABLED=true
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=        # só se usar `opencode serve` manual
OPENCODE_AGENT=tribunal-speaker
# OPENCODE_MODEL=nvidia/google/gemma-4-31b-it
# OPENCODE_PROJECT_DIR=C:/caminho/do/projeto

# Geração de caso: complementos (provas/documentos/cronologia/audiências) em paralelo limitado
TRIAL_SECONDARY_CONCURRENCY=2

# Geração de imagens via Forge: DESATIVADA por padrão (não utilizar no momento).
# Só ative com true se BUILT_IN_FORGE_API_URL e BUILT_IN_FORGE_API_KEY estiverem preenchidos.
IMAGE_GENERATION_ENABLED=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
BUILT_IN_FORGE_API_KEY=
MANUS_MODEL=gemini-2.5-flash

# Manus OAuth (only if using Manus login; leave empty for local development)
VITE_LOCAL_AUTH=true
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
